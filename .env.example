# Copie este arquivo para ".env" (no seu computador) e preencha com os dados
# do Supabase: Project Settings > API Keys / Data API.
# No Netlify, cadastre as mesmas duas variáveis em
# Project configuration > Environment variables.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sua-publishable-key-ou-anon-key
